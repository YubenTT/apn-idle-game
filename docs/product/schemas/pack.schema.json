{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allpatchnotes.com/schemas/apn-idle/pack.schema.json",
  "title": "APN Idle runtime Pack pointer",
  "description": "Closed authored pointer contract. Runtime assets stay in pack.json; rights and provenance live in the referenced versioned rights.json document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "id",
    "order",
    "title",
    "editorialReference",
    "genre",
    "zones",
    "targets",
    "boss",
    "assets",
    "sourceBoard",
    "corruptionMasks",
    "rights",
    "fallback"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 2, "maxLength": 40 },
    "editorialReference": { "type": "string", "minLength": 1, "maxLength": 120 },
    "genre": { "$ref": "#/$defs/id" },
    "zones": { "const": 10 },
    "targets": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/target" } },
    "boss": { "$ref": "#/$defs/boss" },
    "assets": { "$ref": "#/$defs/assets" },
    "motion": { "type": "object" },
    "sourceBoard": { "type": "string", "pattern": "^assets/game-packs/[a-z0-9-]+/source-board\\.md$" },
    "corruptionMasks": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "rights": { "type": "string", "pattern": "^assets/game-packs/[a-z0-9-]+/rights\\.json$" },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reasonCopy", "preserveProgress"],
      "properties": {
        "mode": { "const": "procedural-canvas" },
        "reasonCopy": { "type": "string", "minLength": 10, "maxLength": 160 },
        "preserveProgress": { "const": true }
      }
    }
  },
  "$defs": {
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "label", "frame", "pivot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["common-a", "common-b", "common-c", "elite", "event"] },
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "frame": { "enum": ["common-a", "common-b", "common-c", "elite", "event"] },
        "pivot": { "$ref": "#/$defs/pivot" }
      }
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "frame", "breakFrame", "pivot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "frame": { "const": "boss" },
        "breakFrame": { "const": "boss-break" },
        "pivot": { "$ref": "#/$defs/pivot" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "targets", "targetData", "props", "corruptionMask"],
      "properties": {
        "background": { "$ref": "#/$defs/assetPath" },
        "targets": { "$ref": "#/$defs/assetPath" },
        "targetData": { "$ref": "#/$defs/assetPath" },
        "props": { "$ref": "#/$defs/assetPath" },
        "corruptionMask": { "$ref": "#/$defs/assetPath" }
      }
    },
    "assetPath": {
      "type": "string",
      "pattern": "^assets/game-packs/[a-z0-9-]+/[a-z0-9./-]+\\.(?:webp|json)$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    }
  }
}
