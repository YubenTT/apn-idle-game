{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allpatchnotes.com/schemas/apn-idle/rights.schema.json",
  "title": "APN Idle Pack rights authority",
  "description": "Closed, versioned rights and provenance authority referenced by every authored pack.json and embedded by a full Echo Pack. A pending record states uncertainty; it is never an approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "reviewStatus",
    "reviewedAt",
    "reviewedBy",
    "editorialReference",
    "killSwitch",
    "licenseRecord",
    "forbiddenMotifs",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": {
      "enum": [
        "apn-original",
        "homage-only",
        "editorial-text-original-art",
        "licensed-spotlight",
        "blocked",
        "pending-review"
      ]
    },
    "reviewStatus": {
      "enum": [
        "needs-legal-review",
        "approved-original-echo",
        "licensed",
        "rejected"
      ]
    },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "reviewedBy": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
    "editorialReference": { "type": "string", "minLength": 0, "maxLength": 120 },
    "killSwitch": { "$ref": "#/$defs/id" },
    "licenseRecord": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["recordId", "territories", "expiresAt", "allowedUses"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "territories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 64 } },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "allowedUses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 240 } }
      }
    },
    "forbiddenMotifs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 120 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBoard", "reviewEvidence"],
      "properties": {
        "sourceBoard": { "type": "string", "pattern": "^assets/(?:game-packs|echo-packs)/[a-z0-9-]+/source-board\\.md$" },
        "reviewEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["legal-review", "license", "originality-review"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    }
  }
}
